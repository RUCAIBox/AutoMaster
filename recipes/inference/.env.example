# Export this file before invoking awe-agent (see README).
MODEL_PATH=/path/to/checkpoint
SERVED_MODEL_NAME=automaster
MODEL_BASE_URL=http://127.0.0.1:30000/v1
MODEL_API_KEY=EMPTY
OUTPUT_DIR=./results/automaster

# Terminal: task directory and JSON file containing task IDs.
TB_TASK_DIR=/path/to/terminal-tasks
TB_TASK_IDS=/path/to/task_ids.json

# Doc2Repo: the selected JSONL tasks and test-suite ZIP directory.
DOC2REPO_DATA_FILE=/path/to/doc2repo.jsonl
DOC2REPO_TEST_SUITE_DIR=/path/to/doc2repo-test-suites

# BrowseComp: questions, public search/reader, auxiliary models.
BROWSECOMP_DATA_FILE=/path/to/browsecomp.jsonl
SERPAPI_API_KEY=''
JINA_API_KEY=''
SUMMARY_MODEL=''
SUMMARY_BASE_URL=''
SUMMARY_API_KEY=''
JUDGE_MODEL=''
JUDGE_BASE_URL=''
JUDGE_API_KEY=''
